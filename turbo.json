{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "DATABASE_URL",
    "NODE_ENV",
    "PORT",
    "HOST",
    "PORTLESS_URL",
    "VITE_AUTH_ENABLED",
    "VITE_STUN_URLS",
    "GROK_CONNECTORS_URL",
    "GROK_CONNECTOR_ACCESS_TOKEN",
    "GROK_PROJECT_ID",
    "GROK_GATE_ORIGIN",
    "BROWSER_ALLOW_EXTERNAL_HOST",
    "BROWSER_SMOKE_TIMEOUT_MS",
    "X_CREATOR",
    "X_CREATOR_ID",
    "PREVIEW_THUMBNAIL_TIMEOUT_MS",
    "PREVIEW_READY_TIMEOUT_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".vercel/**", "dist/**", ".nitro/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    },
    "//#lint": {
      "inputs": ["**", "biome.json"]
    },
    "//#format": {
      "cache": false
    },
    "test": {},
    "db:migrate": {
      "cache": false
    }
  }
}
