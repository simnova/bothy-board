{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["./base.json", "@tsconfig/vite-react/tsconfig.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "allowJs": true,
    "checkJs": true,
    "types": ["vite/client", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  }
}
